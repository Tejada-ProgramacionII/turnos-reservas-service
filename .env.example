# Copiar a .env (no se commitea) y completar con los valores reales de la cuenta técnica.

# Secreto HS512 de los JWT de usuario (Base64, al menos 64 bytes): el mismo valor que en
# catalogo-sincronizacion-service, porque el catálogo valida el JWT que le reenvía turnos.
JWT_SECRET=secreto-base64-de-al-menos-64-bytes

# Catálogo. Con compose.yaml el catálogo corre en el host; compose.integrado.yaml lo pisa
# con http://catalogo:8080.
CATALOGO_BASE_URL=http://host.docker.internal:8080

# API REST de la cátedra y JWT técnico de la cuenta del proyecto.
CATEDRA_BASE_URL=http://catedra.example:8090
CATEDRA_JWT=jwt-tecnico-de-ejemplo

# groupId del proyecto en la cátedra (viaja dentro del evento del teléfono).
CATEDRA_GROUP_ID=proyecto-ejemplo

# Kafka de la cátedra: broker, topic de acciones (entrada), topic del teléfono (salida) y
# consumer group propio de turnos (distinto del que usa el catálogo).
KAFKA_BOOTSTRAP_SERVERS=catedra.example:9094
KAFKA_TOPIC_ACCIONES=alumnos.turnos.acciones.proyecto-ejemplo
KAFKA_TOPIC_TELEFONO=catedra.turnos.telefono.proyecto-ejemplo
KAFKA_GRUPO=alumnos-proyecto-ejemplo-turnos

# Opcionales (tienen valor por defecto).
# CATEDRA_CONNECT_TIMEOUT=5s
# CATEDRA_READ_TIMEOUT=30s
# KAFKA_TIMEOUT_ENVIO=15s
# RECONCILIACION_INTERVALO=1m
